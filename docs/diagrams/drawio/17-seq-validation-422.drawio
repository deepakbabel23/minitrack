        <mxCell id="footnote" value="A 422 detail is a plain string, not FastAPI&apos;s array of { loc, msg, type }. Only read detail when it is a string. A 401 body carries no request_id, and an unhandled 500 is text/plain — which is why error bodies are always read with .text()." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;fontFamily=Inter;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="1000" width="1760" height="48" as="geometry"/></mxCell>
