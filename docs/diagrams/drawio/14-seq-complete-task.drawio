        <mxCell id="footnote" value="There is no reopen endpoint and PATCH cannot set completed, so the Complete button simply disappears once the task is done. Under ?status=active the row stays visible until the next reload — it is updated in place, not filtered out." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;fontFamily=Inter;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="1000" width="1760" height="48" as="geometry"/></mxCell>
