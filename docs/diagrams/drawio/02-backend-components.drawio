        <mxCell id="note0" value="app/services/ never imports fastapi. It raises TaskNotFound from app/core/exceptions.py, and app/core/errors.py is the single place that turns a domain exception into an HTTP status." style="shape=note;whiteSpace=wrap;html=1;size=14;dashed=1;align=left;spacingLeft=6;fontSize=14;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#5B21B6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1400" y="545" width="400" height="160" as="geometry"/></mxCell>
        <mxCell id="note1" value="app/db.py is kept only so seed_data.py and the legacy tests/test_seed_data.py keep working. It is on no HTTP request path. Never build a new feature on it." style="shape=note;whiteSpace=wrap;html=1;size=14;dashed=1;align=left;spacingLeft=6;fontSize=14;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1400" y="875" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="footnote" value="Reading the diagram: solid arrows are imports/calls, dashed are wiring and cross-cutting use. Nothing in services/ or data/ points back up into api/." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;fontFamily=Inter;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="1000" width="1760" height="48" as="geometry"/></mxCell>
