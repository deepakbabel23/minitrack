        <mxCell id="footnote" value="Both tiers are decided by one condition in api/client.ts: status === 401 &amp;&amp; !usedExplicitKey. Only the stored-key case disconnects; a rejected candidate on /connect must never log the user out." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;fontFamily=Inter;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="1000" width="1760" height="48" as="geometry"/></mxCell>
