        <mxCell id="footnote" value="Omitting a field does not leave it alone: description omitted writes NULL, priority omitted resets to &apos;medium&apos;. That is why the client wrapper is named replaceTask, and why completed cannot be changed here at all." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;fontFamily=Inter;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="1000" width="1760" height="48" as="geometry"/></mxCell>
