<mxfile host="minitrack-build-diagrams" type="device">
  <diagram id="04-request-pipeline" name="04-request-pipeline">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Request pipeline — the composed ASGI stack" style="text;html=1;align=left;verticalAlign=middle;fontSize=40;fontStyle=1;fontColor=#172033;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="1600" height="56" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Outermost to innermost, as Starlette builds it on the first request" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#475569;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="80" y="96" width="1600" height="34" as="geometry"/></mxCell>
        <mxCell id="n_req" value="Incoming request" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fontSize=17;fontStyle=1;fillColor=#F1F5F9;strokeColor=#475569;fontColor=#1E293B;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="700" y="160" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="n_servererr" value="ServerErrorMiddleware
no handler registered → 500 as text/plain" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fontSize=17;fontStyle=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#1E293B;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="640" y="258" width="540" height="78" as="geometry"/></mxCell>
        <mxCell id="n_cors" value="CORSMiddleware
installed only when MINITRACK_CORS_ORIGINS is non-empty" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fontSize=17;fontStyle=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#115E59;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="640" y="364" width="540" height="78" as="geometry"/></mxCell>
        <mxCell id="n_reqctx" value="RequestContextMiddleware
uuid4 → X-Request-ID header + app.access log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fontSize=17;fontStyle=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#115E59;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="640" y="470" width="540" height="78" as="geometry"/></mxCell>
        <mxCell id="n_excmw" value="ExceptionMiddleware
TaskNotFound → 404 · RequestValidationError → 422" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fontSize=17;fontStyle=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#115E59;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="640" y="576" width="540" height="78" as="geometry"/></mxCell>
        <mxCell id="n_route" value="APIRoute
solve_dependencies → require_api_key resolves first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fontSize=17;fontStyle=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#5B21B6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="640" y="682" width="540" height="78" as="geometry"/></mxCell>
        <mxCell id="n_endpoint" value="endpoint function
run_in_threadpool — every route is def, not async def" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=1;fontSize=17;fontStyle=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#5B21B6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="640" y="788" width="540" height="78" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="html=1;rounded=1;jumpStyle=arc;endArrow=block;dashed=0;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=14;fontStyle=1;fontFamily=Inter;" edge="1" parent="1" source="n_req" target="n_servererr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="html=1;rounded=1;jumpStyle=arc;endArrow=block;dashed=0;strokeColor=#0D9488;fontColor=#115E59;fontSize=14;fontStyle=1;fontFamily=Inter;" edge="1" parent="1" source="n_servererr" target="n_cors"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="html=1;rounded=1;jumpStyle=arc;endArrow=block;dashed=0;strokeColor=#0D9488;fontColor=#115E59;fontSize=14;fontStyle=1;fontFamily=Inter;" edge="1" parent="1" source="n_cors" target="n_reqctx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="html=1;rounded=1;jumpStyle=arc;endArrow=block;dashed=0;strokeColor=#0D9488;fontColor=#115E59;fontSize=14;fontStyle=1;fontFamily=Inter;" edge="1" parent="1" source="n_reqctx" target="n_excmw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="html=1;rounded=1;jumpStyle=arc;endArrow=block;dashed=0;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=14;fontStyle=1;fontFamily=Inter;" edge="1" parent="1" source="n_excmw" target="n_route"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="html=1;rounded=1;jumpStyle=arc;endArrow=block;dashed=0;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=14;fontStyle=1;fontFamily=Inter;" edge="1" parent="1" source="n_route" target="n_endpoint"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note0" value="add_middleware inserts at index 0, so the LAST registered middleware ends up OUTERMOST. create_app() registers RequestContextMiddleware first, then CORSMiddleware." style="shape=note;whiteSpace=wrap;html=1;size=14;dashed=1;align=left;spacingLeft=6;fontSize=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#1E293B;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="105" y="258" width="470" height="145" as="geometry"/></mxCell>
        <mxCell id="note1" value="An OPTIONS preflight is answered by CORSMiddleware and never reaches RequestContextMiddleware — so preflights get no X-Request-ID and no access-log line." style="shape=note;whiteSpace=wrap;html=1;size=14;dashed=1;align=left;spacingLeft=6;fontSize=14;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#115E59;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="105" y="430" width="470" height="145" as="geometry"/></mxCell>
        <mxCell id="note2" value="ExceptionMiddleware sits INSIDE RequestContextMiddleware, which is why get_request_id() still resolves when _error_response builds a 404 or 422 body." style="shape=note;whiteSpace=wrap;html=1;size=14;dashed=1;align=left;spacingLeft=6;fontSize=14;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#115E59;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1245" y="560" width="470" height="145" as="geometry"/></mxCell>
        <mxCell id="note3" value="require_api_key resolves before body validation. A bad key plus a bad body therefore returns 401 — never 422." style="shape=note;whiteSpace=wrap;html=1;size=14;dashed=1;align=left;spacingLeft=6;fontSize=14;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1245" y="730" width="470" height="125" as="geometry"/></mxCell>
        <mxCell id="footnote" value="Reading the diagram: a request travels down the stack and the response travels back up, picking up X-Request-ID and CORS headers on the way out." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;fontFamily=Inter;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="1000" width="1760" height="48" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
