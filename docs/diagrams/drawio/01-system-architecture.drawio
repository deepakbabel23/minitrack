        <mxCell id="e10" value="" style="html=1;rounded=1;jumpStyle=arc;endArrow=block;dashed=0;strokeColor=#B45309;fontColor=#92400E;fontSize=14;fontStyle=1;fontFamily=Inter;" edge="1" parent="1" source="n_repo" target="n_database"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="html=1;rounded=1;jumpStyle=arc;endArrow=block;dashed=0;strokeColor=#B45309;fontColor=#92400E;fontSize=14;fontStyle=1;fontFamily=Inter;" edge="1" parent="1" source="n_database" target="n_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note0" value="Every /tasks call from the browser is preflighted, because X-API-Key is a non-simple header. With MINITRACK_CORS_ORIGINS empty, CORSMiddleware is not installed at all and the SPA cannot reach the API." style="shape=note;whiteSpace=wrap;html=1;size=14;dashed=1;align=left;spacingLeft=6;fontSize=14;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#115E59;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1500" y="190" width="350" height="175" as="geometry"/></mxCell>
        <mxCell id="note1" value="No ORM, no migrations, no connection pool. The schema is CREATE TABLE IF NOT EXISTS, re-run on every connect()." style="shape=note;whiteSpace=wrap;html=1;size=14;dashed=1;align=left;spacingLeft=6;fontSize=14;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#92400E;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1500" y="700" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="footnote" value="Reading the diagram: three peer modules — backend/, frontend/, e2e/. Requests flow left to right and top to bottom; app/core/ and app/schemas/ are cross-cutting and are drawn in 02-backend-components." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;fontFamily=Inter;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="1000" width="1760" height="48" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
