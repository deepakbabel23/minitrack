# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# MS Office lock files, left behind while a doc is open (e.g. ~$deck.pptx)
~$*

# Linux
*~
.directory
.Trash-*
.fuse_hidden*
.nfs*

# SQLite database (created on first run)
minitrack.db

# Local environment — holds MINITRACK_API_KEYS. Never commit.
# .env.example IS tracked and is the template to copy.
.env
.env.*
!.env.example

# Node / frontend
node_modules/
dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.coverage

# Claude Code — machine-local permissions only. A shared .claude/settings.json
# would be tracked, but this repo has none; see .claude/README.md.
.claude/settings.local.json

# Playwright MCP browser scratch (aria snapshots, screenshots)
.playwright-mcp/

# Playwright output, if a run is ever launched from the wrong directory
# (the real ones are covered by e2e/.gitignore)
test-results/
playwright-report/
